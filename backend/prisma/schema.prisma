generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkMode { REMOTE HYBRID ONSITE }
enum ExperienceType { FULL_TIME PART_TIME CONTRACT INTERNSHIP FREELANCE }
enum ResumeVersionStatus { UPLOADED PROCESSING COMPLETED FAILED }
enum JobSourceType { FIXTURE API CAREER_PAGE }
enum JobEmploymentType { FULL_TIME PART_TIME CONTRACT INTERNSHIP TEMPORARY FREELANCE }
enum JobExperienceLevel { INTERN ENTRY MID SENIOR LEAD MANAGER EXECUTIVE }
enum JobStatus { ACTIVE EXPIRED ARCHIVED }
enum IngestionRunStatus { RUNNING COMPLETED FAILED }

model User {
  id           String           @id @default(uuid()) @db.Uuid
  email        String           @unique @db.VarChar(320)
  passwordHash String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  profile      CandidateProfile?
  sessions     Session[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model CandidateProfile {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @unique @db.Uuid
  fullName    String?
  headline    String?
  bio         String?
  location    String?
  websiteUrl  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      CandidateSkill[]
  experience Experience[]
  education  Education[]
  preferences CandidatePreference?
  resumes     Resume[]

  @@index([location])
  @@map("candidate_profiles")
}

model Skill {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @unique @db.VarChar(100)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  candidates CandidateSkill[]
  jobs      JobSkill[]

  @@map("skills")
}

model CandidateSkill {
  id          String          @id @default(uuid()) @db.Uuid
  profileId   String          @db.Uuid
  skillId     String          @db.Uuid
  proficiency Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillId])
  @@index([skillId])
  @@map("candidate_skills")
}

model Experience {
  id          String         @id @default(uuid()) @db.Uuid
  profileId   String         @db.Uuid
  company     String
  title       String
  description String?
  location    String?
  type        ExperienceType @default(FULL_TIME)
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
  @@map("experiences")
}

model Education {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  institution String
  degree      String?
  field       String?
  description String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startDate])
  @@map("education")
}

model CandidatePreference {
  id             String    @id @default(uuid()) @db.Uuid
  profileId      String    @unique @db.Uuid
  desiredTitles  String[]
  locations      String[]
  workModes      WorkMode[]
  minSalary      Int?
  maxSalary      Int?
  salaryCurrency String?   @db.VarChar(3)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("candidate_preferences")
}

model Resume {
  id           String          @id @default(uuid()) @db.Uuid
  profileId    String          @db.Uuid
  name         String          @db.VarChar(160)
  targetRole   String?         @db.VarChar(160)
  isDefault    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  versions     ResumeVersion[]

  @@index([profileId, isDefault])
  @@index([profileId, updatedAt])
  @@map("resumes")
}

model ResumeVersion {
  id               String             @id @default(uuid()) @db.Uuid
  resumeId         String             @db.Uuid
  version          Int
  originalFilename String             @db.VarChar(255)
  mimeType         String             @db.VarChar(127)
  storageKey       String             @unique @db.VarChar(512)
  fileSize         BigInt
  status           ResumeVersionStatus @default(UPLOADED)
  extractedText    String?
  parsedData       Json?
  parsingMetadata  Json?
  failureCode      String?            @db.VarChar(100)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  resume           Resume             @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, version])
  @@index([resumeId, version])
  @@index([resumeId, status])
  @@index([createdAt])
  @@map("resume_versions")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @db.VarChar(200)
  normalizedName String   @unique @db.VarChar(200)
  website        String?
  logoUrl        String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([name])
  @@map("companies")
}

model JobSource {
  id         String         @id @default(uuid()) @db.Uuid
  name       String         @db.VarChar(120)
  type       JobSourceType
  baseUrl    String?
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  records    JobSourceRecord[]
  runs       JobIngestionRun[]

  @@unique([name, type])
  @@map("job_sources")
}

model Job {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @db.Uuid
  title              String             @db.VarChar(300)
  normalizedTitle    String             @db.VarChar(300)
  description        String
  location           String?
  normalizedLocation String?            @db.VarChar(300)
  workMode           WorkMode?
  employmentType     JobEmploymentType?
  experienceLevel    JobExperienceLevel?
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?            @db.VarChar(3)
  salaryText         String?
  postedAt           DateTime?
  expiresAt          DateTime?
  lastSeenAt         DateTime            @default(now())
  status             JobStatus           @default(ACTIVE)
  dedupeKey          String              @unique @db.VarChar(512)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sourceRecords      JobSourceRecord[]
  skills             JobSkill[]

  @@index([status, lastSeenAt])
  @@index([companyId])
  @@index([normalizedTitle])
  @@index([normalizedLocation])
  @@index([workMode])
  @@index([employmentType])
  @@index([experienceLevel])
  @@index([createdAt])
  @@map("jobs")
}

model JobSkill {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model JobSourceRecord {
  id              String    @id @default(uuid()) @db.Uuid
  jobId           String    @db.Uuid
  sourceId        String    @db.Uuid
  externalJobId   String    @db.VarChar(255)
  externalUrl     String?
  rawMetadata     Json?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source          JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalJobId])
  @@index([jobId])
  @@index([sourceId, lastSeenAt])
  @@map("job_source_records")
}

model JobIngestionRun {
  id           String             @id @default(uuid()) @db.Uuid
  sourceId     String             @db.Uuid
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  status       IngestionRunStatus @default(RUNNING)
  fetchedCount Int                @default(0)
  createdCount Int                @default(0)
  updatedCount Int                @default(0)
  skippedCount Int                @default(0)
  failedCount  Int                @default(0)
  errorCode    String?            @db.VarChar(100)
  errorMessage String?            @db.VarChar(500)
  source       JobSource          @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
  @@map("job_ingestion_runs")
}
